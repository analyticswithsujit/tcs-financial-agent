# ── Copy this file to .env and fill in your values ───────────────────────────

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-flash-latest

# MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DB=tcs_forecast

# ChromaDB (persistent directory)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=tcs_documents

# Document download cache
DOC_CACHE_DIR=./doc_cache

# Alpha Vantage (optional – not used by default)
ALPHA_VANTAGE_KEY=
